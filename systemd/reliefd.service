# OS concept: System boot and service management with systemd — Unit 6
#
# TEMPLATE ONLY — not installed. Phase 6 replaces @RELIEF_PREFIX@ with the
# install path and installs this to /etc/systemd/system/ in the test VM.

[Unit]
Description=ReliefOS disaster-relief coordinator daemon
Documentation=file://@RELIEF_PREFIX@/README.md
After=local-fs.target

[Service]
Type=simple
ExecStart=@RELIEF_PREFIX@/build/reliefd \
    --camps @RELIEF_PREFIX@/scenarios/camps.conf \
    --scenario @RELIEF_PREFIX@/scenarios/flood_pune.csv
# reliefd stops its camps itself (SIGTERM, 2 s grace, SIGKILL): only signal the main process.
KillMode=mixed
Environment=RELIEF_HOME=/var/lib/reliefos
StateDirectory=reliefos
Group=relief-admin
UMask=0007
KillSignal=SIGTERM
TimeoutStopSec=10
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
