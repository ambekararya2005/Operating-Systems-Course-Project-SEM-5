#!/usr/bin/env bash
# OS concept: Shell programming — process control via pid files and signals (Unit 1);
#             signals as IPC to camp processes: SIGUSR1 alert, SIGUSR2 dump (Unit 2);
#             live status read from POSIX shared memory via reliefstat (Unit 2)
#
# reliefctl: control the ReliefOS coordinator daemon.
#   RELIEF_HOME     runtime directory (default: <repo>/run)
#   RELIEF_BIN_DIR  directory holding reliefd (default: <repo>/build)
#   RELIEF_WRAP     optional command prefix for reliefd and reliefstat, e.g. "strace -f -o trace.txt"
#   RELIEF_CAMPS    camps config     (default: <repo>/scenarios/camps.conf)
#   RELIEF_SCENARIO scenario CSV     (default: <repo>/scenarios/flood_pune.csv)
#   RELIEF_TIME_SCALE  real ms per simulated minute (default: 100; 0 = no pacing)
set -euo pipefail

ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
RELIEF_HOME=${RELIEF_HOME:-$ROOT/run}
mkdir -p "$RELIEF_HOME"
RELIEF_HOME=$(cd "$RELIEF_HOME" && pwd)
export RELIEF_HOME
BIN_DIR=${RELIEF_BIN_DIR:-$ROOT/build}
read -r -a WRAP <<< "${RELIEF_WRAP:-}"
CAMPS=${RELIEF_CAMPS:-$ROOT/scenarios/camps.conf}
SCENARIO=${RELIEF_SCENARIO:-$ROOT/scenarios/flood_pune.csv}
TIME_SCALE=${RELIEF_TIME_SCALE:-100}
PIDFILE="$RELIEF_HOME/reliefd.pid"
CAMPS_PIDS="$RELIEF_HOME/camps.pids"    # camp table published by reliefd: "<id> <pid> <state> <name>"
LOGDIR="$RELIEF_HOME/logs"
OUTFILE="$LOGDIR/reliefd.out"     # raw stderr of reliefd and its camps
# reliefd itself writes the structured key=value log to $LOGDIR/reliefd.log.

usage() {
    cat <<EOF
usage: reliefctl <command>

commands:
  start      start reliefd and its camps in the background
             (logs: \$RELIEF_HOME/logs/reliefd.log key=value, reliefd.out raw)
  stop       stop reliefd (SIGTERM); it stops and reaps all camps
  status [--json]      reliefd state plus the live camp table from shared memory (reliefstat)
  alert <camp-id|all>  evacuation alert (SIGUSR1): the camp's next 5 requests become CRITICAL
  dump  <camp-id|all>  status dump (SIGUSR2): print the camp's counters
  ps         list camp processes            (coming in Phase 1)
  simulate   run a scenario through reliefd (coming in Phase 2)
  report     summarise experiment results   (coming in Phase 2)
EOF
}

# Prints the daemon pid and returns 0 if reliefd is alive.
daemon_pid() {
    local pid
    [[ -s "$PIDFILE" ]] || return 1
    read -r pid < "$PIDFILE" || return 1
    [[ "$pid" =~ ^[0-9]+$ ]] || return 1
    kill -0 "$pid" 2>/dev/null || return 1
    echo "$pid"
}

cmd_start() {
    local pid
    if pid=$(daemon_pid); then
        echo "reliefd already running (pid $pid)"
        return 0
    fi
    [[ -x "$BIN_DIR/reliefd" ]] || { echo "reliefd not built; run 'make' first" >&2; return 1; }
    rm -f "$PIDFILE"
    mkdir -p "$LOGDIR"
    nohup "${WRAP[@]}" "$BIN_DIR/reliefd" --camps "$CAMPS" --scenario "$SCENARIO" \
        --time-scale "$TIME_SCALE" \
        >>"$OUTFILE" 2>&1 </dev/null &
    for _ in $(seq 50); do
        if pid=$(daemon_pid); then
            echo "reliefd started (pid $pid, home $RELIEF_HOME)"
            return 0
        fi
        sleep 0.1
    done
    echo "reliefd failed to start; see $OUTFILE" >&2
    return 1
}

cmd_stop() {
    local pid
    if ! pid=$(daemon_pid); then
        rm -f "$PIDFILE"
        echo "reliefd not running"
        return 0
    fi
    kill -TERM "$pid"
    for _ in $(seq 50); do
        if ! kill -0 "$pid" 2>/dev/null; then
            echo "reliefd stopped (pid $pid)"
            return 0
        fi
        sleep 0.1
    done
    echo "reliefd (pid $pid) did not stop within 5s" >&2
    return 1
}

cmd_status() {
    local pid stat="$BIN_DIR/reliefstat"
    if [[ "${1:-}" == --json ]]; then
        [[ -x "$stat" ]] || { echo "reliefstat not built; run 'make' first" >&2; return 1; }
        "${WRAP[@]}" "$stat" --json
        return
    fi
    if pid=$(daemon_pid); then
        echo "running  pid=$pid  uptime=$(ps -o etime= -p "$pid" | tr -d ' ')  camps=$(ps -o pid= --ppid "$pid" | wc -l)  home=$RELIEF_HOME"
        if [[ -x "$stat" ]]; then
            "${WRAP[@]}" "$stat" || echo "(live status table unavailable)" >&2
        fi
    else
        echo "stopped  home=$RELIEF_HOME"
    fi
}

# camp_targets <camp-id|all>: print "id pid name" for each matching live camp of reliefd.
# Only pids whose parent is reliefd are returned, so a stale table entry can never
# make us signal an unrelated process that reused the pid.
camp_targets() {
    local want=$1 dpid id pid state name ppid found=0 live=0
    [[ "$want" == all || "$want" =~ ^[0-9]+$ ]] || { echo "camp id must be a number or 'all'" >&2; return 2; }
    dpid=$(daemon_pid) || { echo "reliefd not running" >&2; return 1; }
    [[ -r "$CAMPS_PIDS" ]] || { echo "no camp table at $CAMPS_PIDS" >&2; return 1; }
    while read -r id pid state name; do
        [[ "$id" =~ ^[0-9]+$ ]] || continue     # skip comments
        [[ "$want" == all || "$want" == "$id" ]] || continue
        found=1
        if [[ "$state" != RUNNING && "$state" != STARTING ]]; then
            [[ "$want" == all ]] || echo "camp $id ($name) is $state" >&2
            continue
        fi
        ppid=$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ' || true)
        if [[ "$ppid" != "$dpid" ]]; then
            echo "camp $id: pid $pid is not a child of reliefd (stale camp table?)" >&2
            continue
        fi
        echo "$id $pid $name"
        live=$((live + 1))
    done < "$CAMPS_PIDS"
    (( found )) || { echo "no camp with id $want" >&2; return 1; }
    (( live )) || return 1
}

cmd_alert() {
    local targets id pid name
    targets=$(camp_targets "${1:-}") || return $?
    while read -r id pid name; do
        kill -USR1 "$pid"
        echo "evacuation alert (SIGUSR1) -> camp $id $name (pid $pid)"
    done <<< "$targets"
}

cmd_dump() {
    local targets n before id pid name new
    targets=$(camp_targets "${1:-}") || return $?
    n=$(wc -l <<< "$targets")
    before=$(wc -l < "$OUTFILE" 2>/dev/null || echo 0)
    while read -r id pid name; do
        kill -USR2 "$pid"
    done <<< "$targets"
    # Camps log the dump from their main loop; collect the new status lines from reliefd.out.
    for _ in $(seq 30); do
        new=$(tail -n +"$((before + 1))" "$OUTFILE" 2>/dev/null | grep -c ' event=status ' || true)
        (( new >= n )) && break
        sleep 0.1
    done
    tail -n +"$((before + 1))" "$OUTFILE" 2>/dev/null | grep ' event=status ' | sed 's/.* event=status //' | sort -t= -k2 -n
    (( new >= n )) || { echo "only $new of $n camps answered (see $OUTFILE)" >&2; return 1; }
}

coming() { echo "reliefctl $1: coming in Phase $2"; }

case "${1:-}" in
    start)    cmd_start ;;
    stop)     cmd_stop ;;
    status)   cmd_status "${2:-}" ;;
    alert)    cmd_alert "${2:-}" ;;
    dump)     cmd_dump "${2:-}" ;;
    ps)       coming ps 1 ;;
    simulate) coming simulate 2 ;;
    report)   coming report 2 ;;
    -h|--help|help) usage ;;
    *)        usage >&2; exit 2 ;;
esac
