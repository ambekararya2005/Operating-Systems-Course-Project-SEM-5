#!/usr/bin/env bash
# OS concept: Shell programming — functions, getopts, awk/grep/sed pipelines, exit codes (Unit 1);
#             the Banker's matrices shown in textbook layout and the wait-for graph (Unit 3);
#             process control and the PCB via /proc, signals as IPC to camps (Unit 2);
#             live status read from POSIX shared memory via reliefstat (Unit 2)
#
# reliefctl: control and inspect the ReliefOS coordinator daemon.
#   RELIEF_HOME        runtime directory (default: <repo>/run)
#   RELIEF_BIN_DIR     directory holding reliefd/reliefstat (default: <repo>/build)
#   RELIEF_WRAP        optional command prefix for reliefd and reliefstat, e.g. "strace -f -o trace.txt"
#   RELIEF_CAMPS       camps config  (default: <repo>/scenarios/camps.conf)
#   RELIEF_SCENARIO    scenario CSV  (default: <repo>/scenarios/flood_pune.csv)
#   RELIEF_TIME_SCALE  real ms per simulated minute (default: 100; 0 = no pacing)
#   RELIEF_POLICY      live scheduling policy for RESCUE requests (default: fcfs)
#   RELIEF_TEAMS       rescue team threads (default: 3)
#   RELIEF_DOCK_ARGS   extra reliefd options for the loading dock, e.g. "--dock 4 --trucks 2 --rw semaphore"
#
# Exit status: 0 success, 1 runtime error (e.g. reliefd not running), 2 usage error.
set -euo pipefail

ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
RELIEF_HOME=${RELIEF_HOME:-$ROOT/run}
mkdir -p "$RELIEF_HOME"
RELIEF_HOME=$(cd "$RELIEF_HOME" && pwd)
export RELIEF_HOME
BIN_DIR=${RELIEF_BIN_DIR:-$ROOT/build}
read -r -a WRAP <<< "${RELIEF_WRAP:-}"
CAMPS=${RELIEF_CAMPS:-$ROOT/scenarios/camps.conf}
SCENARIO=${RELIEF_SCENARIO:-$ROOT/scenarios/flood_pune.csv}
TIME_SCALE=${RELIEF_TIME_SCALE:-100}
POLICY=${RELIEF_POLICY:-fcfs}
TEAMS=${RELIEF_TEAMS:-3}
read -r -a DOCK_ARGS <<< "${RELIEF_DOCK_ARGS:-}"
PIDFILE="$RELIEF_HOME/reliefd.pid"
CAMPS_PIDS="$RELIEF_HOME/camps.pids"    # camp table published by reliefd: "<id> <pid> <state> <name>"
LOGDIR="$RELIEF_HOME/logs"
OUTFILE="$LOGDIR/reliefd.out"           # raw stderr of reliefd and its camps
EVENTLOG="$LOGDIR/reliefd.log"          # structured key=value log written by reliefd
PROG=${0##*/}

usage() {
    cat <<EOF
usage: $PROG <command> [options]

commands:
  start                 start reliefd and its camps in the background
  stop                  stop reliefd (SIGTERM); it stops and reaps all camps
  status [--json]       reliefd state plus the live camp table from shared memory (reliefstat)
  sched [--json]        live scheduler: policy, ready queue per level, what each team works on
  banker [--json]       Banker's algorithm: Allocation, Max, Need and Available per camp, and a
                        safe sequence of the current state (from shared memory)
  web [--port N] [--public]
                        local web dashboard on http://127.0.0.1:N/ (default 8080; web/server.py,
                        Python standard library only, offline); Ctrl-C stops it. --public: for a
                        tunnel (cloudflared); remote viewers get a read-only view
  ui                    live ncurses dashboard (build/reliefui): camps, scheduler, Banker's
                        resources, dock, events; keys q p a d k s ? (works before start too)
  waitfor [--dot]       the wait-for graph: "campX -> campY [RESOURCE]" edges and any cycle;
                        --dot prints Graphviz DOT (dot -Tpng waitfor.dot -o waitfor.png)
  ps                    per-process PCB fields from /proc for reliefd and every camp
  tree                  process tree rooted at reliefd
  alert <camp-id|all>   evacuation alert (SIGUSR1): the camp's next 5 requests become CRITICAL
  dump  <camp-id|all>   status dump (SIGUSR2): print the camp's counters
  report [--since MIN | --last-run]
                        requests per camp, severity and resource, the loading dock (occupancy,
                        producers blocked on a full dock), the Banker's grants and waits, and
                        the scheduler's per-severity waits, from the structured log
  simulate flood [--camps N] [--seed S] [--rows R] [--time-scale MS] [--policy P] [--teams T]
                        generate a scenario, run it to completion (every camp sends BYE, every
                        RESCUE request is served and every kit delivered), stop reliefd and
                        print the report
  help                  this message

logs: \$RELIEF_HOME/logs/reliefd.log (key=value), reliefd.out (raw stderr)
EOF
}

die()       { echo "$PROG: $*" >&2; exit 1; }
usage_err() { echo "$PROG: $*" >&2; echo "run '$PROG help' for usage" >&2; exit 2; }

# long_to_short "<long>=<short> ..." args...  ->  fills the global ARGS array.
# Bash getopts only parses short options, so "--camps 8" / "--camps=8" become "-c 8"
# first and getopts then does the real parsing (unknown long options fall through
# as "--name" and getopts reports them).
ARGS=()
long_to_short() {
    local map=$1 a name value m found
    shift
    ARGS=()
    while (( $# )); do
        a=$1
        shift
        if [[ "$a" == -- ]]; then
            ARGS+=("--" "$@")
            return
        fi
        if [[ "$a" != --?* ]]; then
            ARGS+=("$a")
            continue
        fi
        name=${a#--}
        value=""
        if [[ "$name" == *=* ]]; then
            value=${name#*=}
            name=${name%%=*}
        fi
        found=""
        for m in $map; do
            if [[ "${m%%=*}" == "$name" ]]; then
                found=${m#*=}
                break
            fi
        done
        [[ -n "$found" ]] || usage_err "unknown option --$name"
        ARGS+=("-$found")
        if [[ "$a" == *=* ]]; then
            ARGS+=("$value")
        fi
    done
    return 0    # never leak a false test's status into set -e callers
}

is_uint() { [[ "$1" =~ ^[0-9]+$ ]]; }

# Prints the daemon pid and returns 0 if reliefd is alive.
daemon_pid() {
    local pid
    [[ -s "$PIDFILE" ]] || return 1
    read -r pid < "$PIDFILE" || return 1
    [[ "$pid" =~ ^[0-9]+$ ]] || return 1
    kill -0 "$pid" 2>/dev/null || return 1
    echo "$pid"
}

require_daemon() {
    daemon_pid || die "reliefd not running (home $RELIEF_HOME)"
}

# start_daemon [extra reliefd args...]
start_daemon() {
    local pid
    if pid=$(daemon_pid); then
        echo "reliefd already running (pid $pid)"
        return 0
    fi
    [[ -x "$BIN_DIR/reliefd" ]] || die "reliefd not built; run 'make' first"
    rm -f "$PIDFILE"
    mkdir -p "$LOGDIR"
    nohup "${WRAP[@]}" "$BIN_DIR/reliefd" --camps "$CAMPS" --scenario "$SCENARIO" \
        --time-scale "$TIME_SCALE" --policy "$POLICY" --teams "$TEAMS" "${DOCK_ARGS[@]+"${DOCK_ARGS[@]}"}" "$@" \
        >>"$OUTFILE" 2>&1 </dev/null &
    for _ in $(seq 50); do
        if pid=$(daemon_pid); then
            echo "reliefd started (pid $pid, home $RELIEF_HOME)"
            return 0
        fi
        sleep 0.1
    done
    die "reliefd failed to start; see $OUTFILE"
}

cmd_start() {
    (( $# == 0 )) || usage_err "start takes no arguments"
    start_daemon
}

cmd_stop() {
    local pid
    (( $# == 0 )) || usage_err "stop takes no arguments"
    if ! pid=$(daemon_pid); then
        rm -f "$PIDFILE"
        echo "reliefd not running"
        return 0
    fi
    kill -TERM "$pid"
    for _ in $(seq 50); do
        if ! kill -0 "$pid" 2>/dev/null; then
            echo "reliefd stopped (pid $pid)"
            return 0
        fi
        sleep 0.1
    done
    die "reliefd (pid $pid) did not stop within 5s"
}

cmd_status() {
    local pid opt json=0 stat="$BIN_DIR/reliefstat"
    long_to_short "json=j" "$@"
    set -- "${ARGS[@]+"${ARGS[@]}"}"
    local OPTIND=1
    while getopts ":j" opt; do
        case "$opt" in
            j) json=1 ;;
            *) usage_err "status: unknown option -$OPTARG" ;;
        esac
    done
    shift $((OPTIND - 1))
    (( $# == 0 )) || usage_err "status: unexpected argument '$1'"

    if (( json )); then
        [[ -x "$stat" ]] || die "reliefstat not built; run 'make' first"
        "${WRAP[@]}" "$stat" --json
        return
    fi
    if pid=$(daemon_pid); then
        echo "running  pid=$pid  uptime=$(ps -o etime= -p "$pid" | tr -d ' ')  camps=$(ps -o pid= --ppid "$pid" | wc -l)  home=$RELIEF_HOME"
        if [[ -x "$stat" ]]; then
            "${WRAP[@]}" "$stat" || echo "(live status table unavailable)" >&2
        fi
    else
        echo "stopped  home=$RELIEF_HOME"
    fi
}

cmd_sched() {
    local opt json=0 stat="$BIN_DIR/reliefstat"
    long_to_short "json=j" "$@"
    set -- "${ARGS[@]+"${ARGS[@]}"}"
    local OPTIND=1
    while getopts ":j" opt; do
        case "$opt" in
            j) json=1 ;;
            *) usage_err "sched: unknown option -$OPTARG" ;;
        esac
    done
    shift $((OPTIND - 1))
    (( $# == 0 )) || usage_err "sched: unexpected argument '$1'"
    require_daemon >/dev/null
    [[ -x "$stat" ]] || die "reliefstat not built; run 'make' first"
    if (( json )); then
        "${WRAP[@]}" "$stat" --sched --json
    else
        "${WRAP[@]}" "$stat" --sched
    fi
}

# live_camps: "id pid name" for every live camp in the published camp table.
live_camps() {
    [[ -r "$CAMPS_PIDS" ]] || return 0
    awk '$1 ~ /^[0-9]+$/ && ($3 == "RUNNING" || $3 == "STARTING") { print $1, $2, $4 }' "$CAMPS_PIDS"
}

# proc_row <pid> <label>: one line of PCB fields read from /proc/<pid>/{status,stat}.
# Returns 1 if the process vanished meanwhile.
proc_row() {
    local pid=$1 label=$2 status stat
    status=$(cat "/proc/$pid/status" 2>/dev/null) || return 1
    stat=$(cat "/proc/$pid/stat" 2>/dev/null) || return 1
    awk -v pid="$pid" -v label="$label" -v stat="$stat" -v hz="$CLK_TCK" '
        /^State:/                      { state = $2; word = $3; gsub(/[()]/, "", word) }
        /^PPid:/                       { ppid = $2 }
        /^Threads:/                    { threads = $2 }
        /^VmRSS:/                      { rss = $2 " " $3 }
        /^voluntary_ctxt_switches:/    { vol = $2 }
        /^nonvoluntary_ctxt_switches:/ { nonvol = $2 }
        END {
            # /proc/<pid>/stat: "pid (comm) state ppid ...". comm may contain spaces or
            # ")", so cut after the LAST ") ". Then field k of stat is field k-2 here:
            # utime (14) -> 12, stime (15) -> 13, both in clock ticks.
            rest = stat; cut = 0
            while ((i = index(rest, ") ")) > 0) { cut += i + 1; rest = substr(rest, i + 2) }
            n = split(substr(stat, cut + 1), f, " ")
            cpu = (n >= 13) ? (f[12] + f[13]) / hz : 0
            if (rss == "") rss = "-"            # zombies and kernel threads have no RSS
            printf "%7s %7s  %-22s %-14s %7s %10s %9s %10s %8.2fs\n", pid, ppid, label,
                   state " (" word ")", threads, rss, vol, nonvol, cpu
        }' <<< "$status"
}

cmd_ps() {
    local dpid id pid name
    (( $# == 0 )) || usage_err "ps takes no arguments"
    dpid=$(require_daemon)
    CLK_TCK=$(getconf CLK_TCK)
    echo "# PCB fields from /proc/<pid>/status and /proc/<pid>/stat: the kernel's task_struct (the Linux PCB)."
    echo "# STATE: R running/runnable, S interruptible sleep, D uninterruptible (disk) sleep, T stopped,"
    echo "#        Z zombie (exited, not yet reaped). CSW = context switches (voluntary = blocked,"
    echo "#        nonvoluntary = preempted). CPU = utime + stime."
    printf "%7s %7s  %-22s %-14s %7s %10s %9s %10s %9s\n" \
        PID PPID NAME STATE THREADS VmRSS VOL_CSW NONVOL_CSW CPU
    proc_row "$dpid" "reliefd" || true
    while read -r id pid name; do
        [[ -n "$id" ]] || continue
        proc_row "$pid" "camp $id $name" || printf "%7s %7s  %-22s (exited)\n" "$pid" "-" "camp $id $name"
    done < <(live_camps)
}

cmd_tree() {
    local dpid
    (( $# == 0 )) || usage_err "tree takes no arguments"
    dpid=$(require_daemon)
    # Selecting the daemon and its children; --forest draws the parent/child edges.
    ps --forest -o pid,ppid,stat,etime,args -p "$dpid" --ppid "$dpid" | sed 's/  *$//'
    if command -v pstree >/dev/null; then
        echo
        pstree -p "$dpid"
    fi
}

# camp_targets <camp-id|all>: print "id pid name" for each matching live camp of reliefd.
# Only pids whose parent is reliefd are returned, so a stale table entry can never
# make us signal an unrelated process that reused the pid.
camp_targets() {
    local want=$1 dpid id pid state name ppid found=0 live=0
    [[ "$want" == all || "$want" =~ ^[0-9]+$ ]] || usage_err "camp id must be a number or 'all'"
    dpid=$(require_daemon)
    [[ -r "$CAMPS_PIDS" ]] || die "no camp table at $CAMPS_PIDS"
    while read -r id pid state name; do
        [[ "$id" =~ ^[0-9]+$ ]] || continue     # skip comments
        [[ "$want" == all || "$want" == "$id" ]] || continue
        found=1
        if [[ "$state" != RUNNING && "$state" != STARTING ]]; then
            [[ "$want" == all ]] || echo "camp $id ($name) is $state" >&2
            continue
        fi
        ppid=$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ' || true)
        if [[ "$ppid" != "$dpid" ]]; then
            echo "camp $id: pid $pid is not a child of reliefd (stale camp table?)" >&2
            continue
        fi
        echo "$id $pid $name"
        live=$((live + 1))
    done < "$CAMPS_PIDS"
    (( found )) || die "no camp with id $want"
    (( live )) || exit 1
}

cmd_alert() {
    local targets id pid name
    (( $# == 1 )) || usage_err "usage: $PROG alert <camp-id|all>"
    targets=$(camp_targets "$1")
    while read -r id pid name; do
        kill -USR1 "$pid"
        echo "evacuation alert (SIGUSR1) -> camp $id $name (pid $pid)"
    done <<< "$targets"
}

cmd_dump() {
    local targets n before id pid name new=0
    (( $# == 1 )) || usage_err "usage: $PROG dump <camp-id|all>"
    targets=$(camp_targets "$1")
    n=$(wc -l <<< "$targets")
    before=$(wc -l < "$OUTFILE" 2>/dev/null || echo 0)
    while read -r id pid name; do
        kill -USR2 "$pid"
    done <<< "$targets"
    # Camps log the dump from their main loop; collect the new status lines from reliefd.out.
    for _ in $(seq 30); do
        new=$(tail -n +"$((before + 1))" "$OUTFILE" 2>/dev/null | grep -c ' event=status ' || true)
        (( new >= n )) && break
        sleep 0.1
    done
    tail -n +"$((before + 1))" "$OUTFILE" 2>/dev/null | grep ' event=status ' | sed 's/.* event=status //' | sort -t= -k2 -n
    (( new >= n )) || die "only $new of $n camps answered (see $OUTFILE)"
}

# report [--since MIN] [--last-run]: summarise event=request lines of the structured log.
cmd_report() {
    local opt since="" last_run=0 first=1 cutoff="" label="whole log"
    long_to_short "since=m last-run=l" "$@"
    set -- "${ARGS[@]+"${ARGS[@]}"}"
    local OPTIND=1
    while getopts ":m:l" opt; do
        case "$opt" in
            m) is_uint "$OPTARG" || usage_err "report: --since needs whole minutes, got '$OPTARG'"
               since=$OPTARG ;;
            l) last_run=1 ;;
            :) usage_err "report: -$OPTARG needs a value" ;;
            *) usage_err "report: unknown option -$OPTARG" ;;
        esac
    done
    shift $((OPTIND - 1))
    (( $# == 0 )) || usage_err "report: unexpected argument '$1'"
    [[ -r "$EVENTLOG" ]] || die "no log at $EVENTLOG (has reliefd run?)"

    if (( last_run )); then
        first=$(grep -n ' event=daemon_start ' "$EVENTLOG" | tail -n 1 | cut -d: -f1)
        [[ -n "$first" ]] || die "no reliefd run found in $EVENTLOG"
        label="last run (from line $first)"
    fi
    if [[ -n "$since" ]]; then
        # Log timestamps are local ISO-8601, so plain string comparison orders them.
        cutoff=$(date -d "-$since minutes" +%Y-%m-%dT%H:%M:%S)
        label="$label, since $cutoff (last $since min)"
    fi

    awk -v first="$first" -v cutoff="$cutoff" -v label="$label" -v logfile="$EVENTLOG" '
        function parse(   i, kv) {
            delete f
            for (i = 1; i <= NF; i++) { split($i, kv, "="); f[kv[1]] = kv[2] }
        }
        NR < first { next }
        / event=camp_spawn / { parse(); name[f["camp"]] = f["name"]; next }
        / event=sched_start / { parse(); policy = f["policy"]; teams = f["teams"]; next }
        / event=preempt / {
            if (cutoff != "" && substr($1, 4, 19) < cutoff) next
            parse(); preempts++; preason[f["reason"]]++; next
        }
        / event=promote / {
            if (cutoff != "" && substr($1, 4, 19) < cutoff) next
            promotes++; next
        }
        / event=sched_stop / { parse(); abandoned += f["abandoned"]; next }
        / event=dock_start / { parse(); dcap = f["capacity"]; dprod = f["producers"]; dtrucks = f["trucks"]; drw = f["rw"]; next }
        / event=dock_stop / {
            if (cutoff != "" && substr($1, 4, 19) < cutoff) next
            parse(); dtw = f["avg_occupancy"]; dstops++; next
        }
        / event=(produce|consume) / {
            if (cutoff != "" && substr($1, 4, 19) < cutoff) next
            parse()
            occ += f["occupancy"]; nocc++
            if (f["occupancy"] + 0 > maxocc) maxocc = f["occupancy"] + 0
            if ($0 ~ / event=produce /) {
                nprod++
                if (f["blocked_min"] + 0 > 0) { nblocked++; blocked += f["blocked_min"] }
            } else ncons++
            next
        }
        / event=deliver / {
            if (cutoff != "" && substr($1, 4, 19) < cutoff) next
            parse(); ndel++; age += f["age_min"]; next
        }
        / event=restock / {
            if (cutoff != "" && substr($1, 4, 19) < cutoff) next
            restocks++; next
        }
        / event=banker_start / { parse(); bmode = f["mode"]; btotal = f["total"]; next }
        / event=(grant|deny_unsafe|wait_unavailable|release|reject_over_claim) / {
            if (cutoff != "" && substr($1, 4, 19) < cutoff) next
            parse()
            if ($0 ~ / event=grant /) { bg++; bgn[f["resource"]]++; bgw[f["resource"]] += f["waited_min"]
                                         if (f["waited_min"] + 0 > bgmax[f["resource"]] + 0) bgmax[f["resource"]] = f["waited_min"] }
            else if ($0 ~ / event=deny_unsafe /) bu++
            else if ($0 ~ / event=wait_unavailable /) bw++
            else if ($0 ~ / event=release /) brel++
            else brej++
            next
        }
        / event=complete / {
            if (cutoff != "" && substr($1, 4, 19) < cutoff) next
            parse()
            s = f["severity"]
            done++; dn[s]++; dw[s] += f["wait"]; dt[s] += f["turnaround"]; dr[s] += f["response"]
            if (f["wait"] + 0 > dmax[s] + 0) dmax[s] = f["wait"]
            allw += f["wait"]; allt += f["turnaround"]
            next
        }
        / event=request / {
            if (cutoff != "" && substr($1, 4, 19) < cutoff) next
            parse()
            total++
            camp[f["camp"]]++; sev[f["severity"]]++; res[f["resource"]]++
            if (f["alert"] == 1) escalated++
            if (firstts == "") firstts = substr($1, 4)
            lastts = substr($1, 4)
        }
        END {
            printf "ReliefOS request report\n  log: %s\n  window: %s\n", logfile, label
            if (total == 0) { print "  no requests in this window"; exit 0 }
            printf "  requests: %d (first %s, last %s), escalated by alerts: %d\n\n",
                   total, firstts, lastts, escalated + 0
            printf "Per camp\n  %3s  %-14s %8s %7s\n", "ID", "NAME", "REQUESTS", "SHARE"
            for (c in camp) ids[++n] = c + 0
            for (i = 2; i <= n; i++) {              # insertion sort by camp id
                v = ids[i]; for (j = i - 1; j >= 1 && ids[j] > v; j--) ids[j + 1] = ids[j]; ids[j + 1] = v
            }
            for (i = 1; i <= n; i++) {
                c = ids[i]
                printf "  %3d  %-14s %8d %6.1f%%\n", c, (c in name) ? name[c] : "?", camp[c], 100 * camp[c] / total
                if (camp[c] > best) { best = camp[c]; busiest = c }
            }
            printf "\nPer severity\n"
            split("CRITICAL URGENT ROUTINE", order, " ")
            for (i = 1; i <= 3; i++)
                printf "  %-12s %6d %6.1f%%\n", order[i], sev[order[i]], 100 * sev[order[i]] / total
            printf "\nPer resource\n"
            split("RESCUE BOAT TRUCK MED_KIT FOOD_KIT HYGIENE_KIT", rorder, " ")
            for (i = 1; i <= 6; i++)
                printf "  %-12s %6d %6.1f%%\n", rorder[i], res[rorder[i]], 100 * res[rorder[i]] / total
            printf "\nBusiest camp: %d %s (%d requests, %.1f%%)\n", busiest,
                   (busiest in name) ? name[busiest] : "?", best, 100 * best / total

            printf "\nLoading dock (kit packages, warehouse producers -> trucks; times in simulated minutes)\n"
            if (nprod + ncons == 0) print "  no dock activity in this window"
            else {
                printf "  capacity %s, %s producers, %s trucks, inventory lock %s\n", dcap == "" ? "?" : dcap,
                       dprod == "" ? "?" : dprod, dtrucks == "" ? "?" : dtrucks, drw == "" ? "?" : drw
                printf "  produced %d, consumed %d, delivered %d, restocks %d\n", nprod, ncons, ndel, restocks + 0
                printf "  average occupancy %.2f (sampled at each put and take), max %d", occ / nocc, maxocc
                if (dstops == 1) printf "; time-weighted %.2f", dtw
                printf "\n  producers blocked on a full dock: %d of %d puts, %.1f min in total", nblocked + 0, nprod, blocked
                if (nblocked) printf " (%.1f per blocked put)", blocked / nblocked
                printf "\n"
                if (ndel) printf "  average time from dock to delivery: %.1f min\n", age / ndel
            }

            printf "\nDeadlock avoidance (Banker'"'"'s algorithm; vehicles and kit crates; times in simulated minutes)\n"
            if (bg + bu + bw + brel + brej == 0) print "  no Banker'"'"'s activity in this window"
            else {
                printf "  mode %s, totals TRUCK,BOAT,MED_KIT,FOOD_KIT = %s\n", bmode == "" ? "?" : bmode,
                       btotal == "" ? "?" : btotal
                printf "  granted %d, released %d, rejected %d; waits: %d unsafe, %d not available\n",
                       bg, brel, brej + 0, bu + 0, bw + 0
                printf "  %-10s %7s %13s %10s\n", "RESOURCE", "GRANTS", "AVG WAIT", "MAX WAIT"
                split("TRUCK BOAT MED_KIT FOOD_KIT", border, " ")
                for (i = 1; i <= 4; i++) { r = border[i]
                    if (bgn[r]) printf "  %-10s %7d %13.1f %10.1f\n", r, bgn[r], bgw[r] / bgn[r], bgmax[r]
                    else printf "  %-10s %7d %13s %10s\n", r, 0, "-", "-" }
            }

            printf "\nScheduler (RESCUE requests; times in simulated minutes)\n"
            if (done == 0) { print "  no completed RESCUE requests in this window"; exit 0 }
            printf "  policy %s, %s teams: completed %d, average wait %.1f, average turnaround %.1f\n",
                   policy == "" ? "?" : policy, teams == "" ? "?" : teams, done, allw / done, allt / done
            printf "  preemptions %d", preempts + 0
            if (preempts) {
                printf " ("; sep = ""
                for (r in preason) { printf "%s%s %d", sep, r, preason[r]; sep = ", " }
                printf ")"
            }
            printf ", promotions %d, abandoned at stop %d\n", promotes + 0, abandoned + 0
            printf "  %-10s %5s %9s %15s %13s %9s\n", "SEVERITY", "DONE", "AVG WAIT", "AVG TURNAROUND",
                   "AVG RESPONSE", "MAX WAIT"
            for (i = 1; i <= 3; i++) {
                s = order[i]
                if (dn[s] == 0) { printf "  %-10s %5d %9s %15s %13s %9s\n", s, 0, "-", "-", "-", "-"; continue }
                printf "  %-10s %5d %9.1f %15.1f %13.1f %9.1f\n", s, dn[s], dw[s] / dn[s], dt[s] / dn[s],
                       dr[s] / dn[s], dmax[s]
            }
        }' "$EVENTLOG"
}

# make_camps_conf <n> <file>: the first n camps of camps.conf, padded with generic names.
cmd_banker() {
    local opt json=0 stat="$BIN_DIR/reliefstat"
    long_to_short "json=j" "$@"
    set -- "${ARGS[@]+"${ARGS[@]}"}"
    local OPTIND=1
    while getopts ":j" opt; do
        case "$opt" in
            j) json=1 ;;
            *) usage_err "banker: unknown option -$OPTARG" ;;
        esac
    done
    shift $((OPTIND - 1))
    (( $# == 0 )) || usage_err "banker: unexpected argument '$1'"
    require_daemon >/dev/null
    [[ -x "$stat" ]] || die "reliefstat not built; run 'make' first"
    if (( json )); then
        "${WRAP[@]}" "$stat" --banker --json
    else
        "${WRAP[@]}" "$stat" --banker
    fi
}

cmd_web() {
    local opt port=8080 public=()
    long_to_short "port=p public=P" "$@"
    set -- "${ARGS[@]+"${ARGS[@]}"}"
    local OPTIND=1
    while getopts ":p:P" opt; do
        case "$opt" in
            p) port=$OPTARG ;;
            P) public=(--public) ;;
            :) usage_err "web: -$OPTARG needs a value" ;;
            *) usage_err "web: unknown option -$OPTARG" ;;
        esac
    done
    shift $((OPTIND - 1))
    (( $# == 0 )) || usage_err "web: unexpected argument '$1'"
    if ! is_uint "$port" || (( port < 1 || port > 65535 )); then
        usage_err "web: --port must be 1-65535"
    fi
    [[ -x "$BIN_DIR/reliefstat" ]] || die "reliefstat not built; run 'make' first"
    command -v python3 >/dev/null || die "python3 not found"
    RELIEF_BIN_DIR="$BIN_DIR" exec python3 -I "$ROOT/web/server.py" --port "$port" "${public[@]+"${public[@]}"}"
}

cmd_ui() {
    [[ -x "$BIN_DIR/reliefui" ]] || die "reliefui not built; run 'make' first"
    # The dashboard calls this script for start/stop/alert/dump, with the same RELIEF_HOME.
    RELIEFCTL="$ROOT/scripts/$PROG" exec "${WRAP[@]}" "$BIN_DIR/reliefui" "$@"
}

cmd_waitfor() {
    local opt dot=0 stat="$BIN_DIR/reliefstat"
    long_to_short "dot=d" "$@"
    set -- "${ARGS[@]+"${ARGS[@]}"}"
    local OPTIND=1
    while getopts ":d" opt; do
        case "$opt" in
            d) dot=1 ;;
            *) usage_err "waitfor: unknown option -$OPTARG" ;;
        esac
    done
    shift $((OPTIND - 1))
    (( $# == 0 )) || usage_err "waitfor: unexpected argument '$1'"
    require_daemon >/dev/null
    [[ -x "$stat" ]] || die "reliefstat not built; run 'make' first"
    if (( dot )); then
        "${WRAP[@]}" "$stat" --waitfor --dot
    else
        "${WRAP[@]}" "$stat" --waitfor
    fi
}

make_camps_conf() {
    local n=$1 out=$2
    awk -v n="$n" '
        $1 ~ /^[0-9]+$/ && count < n { print $1, $2; count++; used[$1] = 1 }
        END { for (id = 1; count < n; id++) if (!(id in used)) { print id, "Camp" id; count++ } }
    ' "$ROOT/scenarios/camps.conf" > "$out"
}

cmd_simulate() {
    local opt kind camps=8 seed=2019 rows=200 scale=10 policy=$POLICY teams=$TEAMS
    local dir conf csv start_line byes=0 dpid timeout_s v sched=0 served=0 kits=0 delivered=0
    [[ $# -ge 1 ]] || usage_err "usage: $PROG simulate flood [--camps N] [--seed S] [--rows R] [--time-scale MS] [--policy P] [--teams T]"
    kind=$1
    shift
    [[ "$kind" == flood ]] || usage_err "simulate: unknown scenario '$kind' (supported: flood)"
    long_to_short "camps=c seed=s rows=r time-scale=t policy=p teams=n" "$@"
    set -- "${ARGS[@]+"${ARGS[@]}"}"
    local OPTIND=1
    while getopts ":c:s:r:t:p:n:" opt; do
        case "$opt" in
            c) camps=$OPTARG ;;
            s) seed=$OPTARG ;;
            r) rows=$OPTARG ;;
            t) scale=$OPTARG ;;
            p) policy=$OPTARG ;;
            n) teams=$OPTARG ;;
            :) usage_err "simulate: -$OPTARG needs a value" ;;
            *) usage_err "simulate: unknown option -$OPTARG" ;;
        esac
    done
    shift $((OPTIND - 1))
    (( $# == 0 )) || usage_err "simulate: unexpected argument '$1'"
    for v in "$camps" "$seed" "$rows" "$scale" "$teams"; do
        is_uint "$v" || usage_err "simulate: options need non-negative integers, got '$v'"
    done
    (( camps >= 1 && camps <= 64 )) || usage_err "simulate: --camps must be 1-64"
    (( rows >= camps )) || usage_err "simulate: --rows must be at least --camps"
    (( teams >= 1 && teams <= 16 )) || usage_err "simulate: --teams must be 1-16"
    [[ "$policy" =~ ^(fcfs|sjf|srtf|rr|prio|mlfq)$ ]] || usage_err "simulate: unknown policy '$policy'"
    if dpid=$(daemon_pid); then
        die "reliefd already running (pid $dpid); stop it before simulating"
    fi

    dir="$RELIEF_HOME/sim"
    mkdir -p "$dir"
    conf="$dir/camps_${camps}.conf"
    csv="$dir/flood_c${camps}_s${seed}_r${rows}.csv"
    make_camps_conf "$camps" "$conf"
    python3 -I "$ROOT/experiments/gen_scenario.py" --camps "$camps" --seed "$seed" --rows "$rows" -o "$csv" \
        || die "scenario generation failed"
    echo "scenario: $csv ($rows requests, $camps camps, seed $seed, $scale ms per simulated minute)"
    echo "scheduler: policy $policy, $teams teams (RESCUE requests only)"

    mkdir -p "$LOGDIR"
    touch "$EVENTLOG"
    start_line=$(( $(wc -l < "$EVENTLOG") + 1 ))
    CAMPS=$conf SCENARIO=$csv TIME_SCALE=$scale POLICY=$policy TEAMS=$teams \
        start_daemon --seed "$seed" --exit-when-done
    dpid=$(daemon_pid) || die "reliefd did not start"

    # Wait until every camp has replayed its rows and sent BYE (camps run with --exit-when-done).
    timeout_s=$(( 360 * scale / 1000 + 30 ))
    for _ in $(seq $((timeout_s * 10))); do
        byes=$(tail -n +"$start_line" "$EVENTLOG" | grep -c ' event=bye ' || true)
        (( byes >= camps )) && break
        kill -0 "$dpid" 2>/dev/null || die "reliefd exited during the simulation; see $OUTFILE"
        sleep 0.1
    done
    (( byes >= camps )) || { cmd_stop >/dev/null || true; die "timed out: $byes of $camps camps sent BYE"; }
    echo "all $camps camps sent BYE"

    # Then wait until the rescue teams have served every scheduled request and the trucks
    # have delivered every kit package.
    for _ in $(seq $((timeout_s * 10))); do
        sched=$(tail -n +"$start_line" "$EVENTLOG" | grep -c ' event=request .* sched=1' || true)
        served=$(tail -n +"$start_line" "$EVENTLOG" | grep -c ' event=complete ' || true)
        kits=$(tail -n +"$start_line" "$EVENTLOG" | grep -c ' event=request .* dock=1' || true)
        delivered=$(tail -n +"$start_line" "$EVENTLOG" | grep -c ' event=deliver ' || true)
        (( served >= sched && delivered >= kits )) && break
        kill -0 "$dpid" 2>/dev/null || die "reliefd exited during the simulation; see $OUTFILE"
        sleep 0.1
    done
    (( served >= sched )) || { cmd_stop >/dev/null || true; die "timed out: $served of $sched RESCUE requests served"; }
    (( delivered >= kits )) || { cmd_stop >/dev/null || true; die "timed out: $delivered of $kits kit packages delivered"; }
    echo "all $sched RESCUE requests served by the teams, all $kits kit packages delivered"
    cmd_stop
    echo
    cmd_report --last-run
}

main() {
    local cmd=${1:-}
    [[ -n "$cmd" ]] || { usage >&2; exit 2; }
    shift
    case "$cmd" in
        start)          cmd_start "$@" ;;
        stop)           cmd_stop "$@" ;;
        status)         cmd_status "$@" ;;
        sched)          cmd_sched "$@" ;;
        banker)         cmd_banker "$@" ;;
        waitfor)        cmd_waitfor "$@" ;;
        ui)             cmd_ui "$@" ;;
        web)            cmd_web "$@" ;;
        ps)             cmd_ps "$@" ;;
        tree)           cmd_tree "$@" ;;
        alert)          cmd_alert "$@" ;;
        dump)           cmd_dump "$@" ;;
        report)         cmd_report "$@" ;;
        simulate)       cmd_simulate "$@" ;;
        -h|--help|help) usage ;;
        *)              usage_err "unknown command '$cmd'" ;;
    esac
}

main "$@"
